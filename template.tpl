// Import required GTM APIs (NO Object import)
const log = require('logToConsole');
const injectScript = require('injectScript');
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const callInWindow = require('callInWindow');
const getType = require('getType');
const getUrl = require('getUrl');
const getReferrerUrl = require('getReferrerUrl');
const sendPixel = require('sendPixel');
const getTimestampMillis = require('getTimestampMillis');
const JSON = require('JSON');
const encodeUriComponent = require('encodeUriComponent');

// Extract template variables
const pixelId = data.pixelId;
const cnameEndpoint = data.cnameEndpoint;
const eventType = data.eventType;
const enableDebugMode = data.enableDebugMode;
const customParameters = data.customParameters || [];

// Universal script URL (same for all customers)
const scriptUrl = 'https://tm.winflncr.com/js/core-script.js';

// Debug logging helper
const debugLog = (message, debugData) => {
  if (enableDebugMode) {
    log('[GTM Template Debug] ' + message, debugData || '');
  }
};

// Build API endpoint from CNAME configuration
const buildApiEndpoint = (endpoint) => {
  if (!endpoint) {
    return 'https://api.winflncr.com/collect';
  }
  
  // If customer enters just domain (e.g., win.customer.com)
  if (endpoint.indexOf('http') === -1) {
    return 'https://' + endpoint + '/collect';
  }
  
  // If customer enters full URL, ensure it ends with /collect
  if (endpoint.indexOf('/collect') === -1) {
    return endpoint + '/collect';
  }
  
  // Customer entered complete URL
  return endpoint;
};

// Build configuration object for the core script
const buildConfiguration = () => {
  const config = {};
  
  // Set CNAME endpoint for data collection
  const apiEndpoint = buildApiEndpoint(cnameEndpoint);
  config.apiEndpoint = apiEndpoint;
  debugLog('API endpoint configured', apiEndpoint);
  
  if (enableDebugMode) {
    config.debugMode = true;
  }
  
  // Set default configuration
  config.telemetryEnabled = true;
  config.performanceMonitoringEnabled = true;
  config.piiValidationEnabled = true;
  config.attributionWindow = 90 * 24 * 60 * 60 * 1000; // 90 days default
  config.sessionTimeout = 30 * 60 * 1000; // 30 minutes
  config.maxRetries = 3;
  config.retryDelay = 1000;
  
  return config;
};

// Extract campaign parameters from URL
const extractCampaignParameters = () => {
  const campaignParams = {};
  
  // Winfluencer-specific parameters
  const winParams = ['win_campaign_id', 'win_influencer_id', 'win_content_id'];
  // Standard UTM parameters  
  const utmParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  
  const allParams = winParams.concat(utmParams);
  for (let i = 0; i < allParams.length; i++) {
    const param = allParams[i];
    const value = getUrl(param);
    if (value) {
      campaignParams[param] = value;
    }
  }
  
  // Check if object has any properties (GTM-compatible way)
  let hasParams = false;
  for (let key in campaignParams) {
    if (campaignParams.hasOwnProperty && campaignParams.hasOwnProperty(key)) {
      hasParams = true;
      break;
    }
  }
  
  return hasParams ? campaignParams : null;
};

// Build event parameters for tracking
const buildEventParameters = () => {
  const eventParams = {};
  
  // Add custom parameters
  if (customParameters && customParameters.length > 0) {
    for (let i = 0; i < customParameters.length; i++) {
      const param = customParameters[i];
      if (param.name && param.value) {
        eventParams[param.name] = param.value;
      }
    }
  }
  
  // Add page context
  eventParams.page_url = getUrl();
  eventParams.referrer = getReferrerUrl();
  eventParams.timestamp = getTimestampMillis();
  
  // Include campaign data if available
  const campaignData = extractCampaignParameters();
  if (campaignData) {
    eventParams.campaign_data = campaignData;
    debugLog('Campaign parameters detected', campaignData);
  }
  
  return eventParams;
};

// Execute initialization and tracking
const executeWinfluencerTracking = () => {
  const win = copyFromWindow('win');
  
  if (!win || getType(win) !== 'function') {
    debugLog('ERROR: Winfluencer script not ready');
    data.gtmOnFailure();
    return;
  }
  
  debugLog('Winfluencer script is ready, starting tracking');
  
  // STEP 1: Always initialize the pixel first
  debugLog('STEP 1: Initializing pixel', pixelId);
  callInWindow('win', 'init', pixelId);
  
  // STEP 2: Track the event
  const eventParams = buildEventParameters();
  debugLog('STEP 2: Tracking event', { 
    eventType: eventType, 
    params: eventParams 
  });
  callInWindow('win', 'track', eventType, eventParams);
  
  debugLog('SUCCESS: Both init and track completed');
  data.gtmOnSuccess();
};

// Build fallback pixel URL
const buildFallbackEndpoint = (endpoint) => {
  if (!endpoint) {
    return 'https://api.winflncr.com/collect/pixel';
  }
  
  if (endpoint.indexOf('http') === -1) {
    return 'https://' + endpoint + '/collect/pixel';
  }
  
  if (endpoint.indexOf('/collect/pixel') === -1) {
    if (endpoint.indexOf('/collect') !== -1) {
      return endpoint.replace('/collect', '/collect/pixel');
    } else {
      return endpoint + '/collect/pixel';
    }
  }
  
  return endpoint;
};

// Fallback pixel tracking
const sendFallbackPixel = () => {
  debugLog('Using fallback pixel method');
  
  const fallbackEndpoint = buildFallbackEndpoint(cnameEndpoint);
  const eventParams = buildEventParameters();
  
  const fallbackData = {
    event_name: eventType,
    pixel_id: pixelId,
    page_url: getUrl(),
    referrer: getReferrerUrl(),
    timestamp: getTimestampMillis(),
    fallback: true,
    gtm_template: true
  };
  
  // Add custom parameters to fallback
  if (customParameters && customParameters.length > 0) {
    for (let i = 0; i < customParameters.length; i++) {
      const param = customParameters[i];
      if (param.name && param.value) {
        fallbackData[param.name] = param.value;
      }
    }
  }
  
  // Add campaign data
  if (eventParams.campaign_data) {
    fallbackData.campaign_data = eventParams.campaign_data;
  }
  
  const pixelUrl = fallbackEndpoint + '?data=' + encodeUriComponent(JSON.stringify(fallbackData));
  debugLog('Sending fallback pixel', { url: fallbackEndpoint, data: fallbackData });
  
  sendPixel(pixelUrl, data.gtmOnSuccess, data.gtmOnFailure);
};

// Enhanced script readiness checker with more aggressive retries
const waitForScript = (callback, attempt, maxAttempts) => {
  debugLog('Checking script readiness', { attempt: attempt, maxAttempts: maxAttempts });
  
  const win = copyFromWindow('win');
  
  if (win && getType(win) === 'function') {
    debugLog('Script ready on attempt ' + attempt);
    callback();
  } else if (attempt < maxAttempts) {
    debugLog('Script not ready, retrying...');
    waitForScript(callback, attempt + 1, maxAttempts);
  } else {
    debugLog('Script failed to load after ' + maxAttempts + ' attempts, using fallback');
    sendFallbackPixel();
  }
};

// Main execution logic
const main = () => {
  debugLog('=== GTM Template Starting ===');
  debugLog('Configuration', {
    pixelId: pixelId,
    cnameEndpoint: cnameEndpoint,
    eventType: eventType,
    enableDebugMode: enableDebugMode
  });
  
  // Validate required fields
  if (!pixelId) {
    debugLog('ERROR: Missing pixel ID');
    data.gtmOnFailure();
    return;
  }
  
  if (!eventType) {
    debugLog('ERROR: Missing event type');
    data.gtmOnFailure();
    return;
  }
  
  // Set up configuration for the core script
  const config = buildConfiguration();
  setInWindow('__win_config', config);
  debugLog('Configuration set in window.__win_config', config);
  
  // Check if script is already loaded
  const existingWin = copyFromWindow('win');
  
  if (existingWin && getType(existingWin) === 'function') {
    debugLog('Winfluencer script already loaded, executing immediately');
    executeWinfluencerTracking();
  } else {
    debugLog('Loading Winfluencer script', scriptUrl);
    
    // Load the script
    injectScript(scriptUrl, () => {
      debugLog('Script injection successful, waiting for readiness');
      
      // Wait for script to be fully ready with multiple retries
      waitForScript(executeWinfluencerTracking, 1, 8);
      
    }, () => {
      debugLog('Script injection failed, using fallback');
      sendFallbackPixel();
    });
  }
};

// Start execution
debugLog('GTM Template loaded, starting main execution');
main();


